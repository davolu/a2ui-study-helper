# Copy this file to .env, remove the "# " in front of a line and fill in your own value.
#   cp .env.example .env
# Never commit .env (it is already in .gitignore).

# Optional. Your Gemini API key (free at https://aistudio.google.com/apikey).
# Without it, Study Helper runs the offline "scripted" agent.
# GEMINI_API_KEY=your-gemini-api-key

# Optional. Which Gemini model to try first (the agent tries others if it is busy).
# GEMINI_MODEL=gemini-3.8-flash

# Optional. Port for the app (default 8000).
# PORT=8000
